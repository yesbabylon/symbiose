{
    "name": "Documents list",
    "description": "This view displays the list of orders: the most recent on top.",
    "access": {
        "groups": ["documents.default.users"]
    },
    "controller": "core_model_chart",
    "layout": {
        "entity": "document\\document\\Document",
        "group_by": "range",
        "range_interval": "year",
        "range_from": "date.this.year.first",
        "range_to": "date.this.year.last",
        "datasets": [
            {
                "label" : "Taille des documents",
                "operation": ["SUM",["/", "object.content_size", 1000]],
                "domain"   : ["content_size", ">", 0]
            }
        ]
    }
}
