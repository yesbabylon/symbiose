{
    "name": "Invoice Line",
    "description": "Invoice lines describe the products and quantities that are part of an invoice.",
    "access": {
        "groups": ["purchase.default.users"]
    },
    "header": {
        "actions": {
            "ACTION.EDIT": false
        }
    },
    "layout": {
        "groups": [
            {
                "sections": [
                    {
                        "id": "section.details",
                        "label": "Line details",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "description",
                                                "width": "100%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "invoice_id",
                                                "width": "100%",
                                                "readonly": true
                                            },
                                            {
                                                "type": "field",
                                                "value": "account_id",
                                                "width": "70%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "account_code",
                                                "width": "30%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "vat_rate",
                                                "width": "30%"
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "debit",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "credit",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "is_expense",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "is_income",
                                                "width": "50%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
