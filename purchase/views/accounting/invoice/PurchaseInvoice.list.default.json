{
    "name": "Invoice",
    "description": "An invoice is a legal document issued by a seller to a buyer that relates to a sale, and is part of the accounting system.",
    "access": {
        "groups": ["purchase.default.users"]
    },
    "controller": "purchase_accounting_invoice_collect",
    "domain": ["supplier_id", ">", 0],
    "header": {
        "actions": {
            "ACTION.CREATE": false
        }
    },
    "order": "posting_date",
    "sort": "desc",
    "limit": 100,
    "layout": {
        "items": [
            {
                "id": "item.name",
                "type": "field",
                "value": "name",
                "width": "20%"
            },
            {
                "id": "item.supplier",
                "type": "field",
                "label": "Supplier",
                "value": "supplier_id",
                "width": "20%"
            },
            {
                "id": "item.posting.date",
                "type": "field",
                "value": "posting_date",
                "width": "20%",
                "sortable": true,
                "widget": {
                    "usage": "date/plain.short"
                }
            },
            {
                "type": "field",
                "value": "status",
                "width": "20%"
            }
        ]
    }
}
