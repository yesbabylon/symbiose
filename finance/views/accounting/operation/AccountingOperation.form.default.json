{
    "name": "Accounting operation",
    "description": "Accounting operation details.",
    "access": {
        "groups": ["finance.default.users"]
    },
    "actions": [
        {
            "id": "action.submit",
            "label": "Submit",
            "description": "Mark the operation as complete and ready for posting.",
            "controller": "core_model_transition",
            "visible": ["status", "=", "pending"],
            "params": {
                "entity": "finance\\accounting\\operation\\AccountingOperation",
                "transition": "submit",
                "ids": []
            }
        },
        {
            "id": "action.revert",
            "label": "Reopen",
            "description": "Return the operation to the pending state.",
            "controller": "core_model_transition",
            "visible": ["status", "=", "proforma"],
            "params": {
                "entity": "finance\\accounting\\operation\\AccountingOperation",
                "transition": "revert",
                "ids": []
            }
        },
        {
            "id": "action.post",
            "label": "Post",
            "description": "Post the operation to accounting.",
            "controller": "core_model_transition",
            "visible": ["status", "=", "proforma"],
            "params": {
                "entity": "finance\\accounting\\operation\\AccountingOperation",
                "transition": "post",
                "ids": []
            }
        },
        {
            "id": "action.cancel",
            "label": "Cancel",
            "description": "Cancel the operation and reverse it when already posted.",
            "controller": "core_model_transition",
            "confirm": true,
            "visible": ["status", "in", ["pending", "proforma", "posted"]],
            "params": {
                "entity": "finance\\accounting\\operation\\AccountingOperation",
                "transition": "cancel",
                "ids": []
            }
        }
    ],
    "layout": {
        "groups": [
            {
                "sections": [
                    {
                        "id": "section.general",
                        "label": "General information",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "name",
                                                "width": "100%",
                                                "widget": {
                                                    "heading": true,
                                                    "readonly": true
                                                }
                                            },
                                            {
                                                "type": "field",
                                                "value": "description",
                                                "width": "100%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "operation_type",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "status",
                                                "width": "50%"
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "org_id",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "journal_id",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "posting_date",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "fiscal_year",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "operation_number",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "is_balanced",
                                                "width": "50%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "sections": [
                    {
                        "id": "section.operation_lines",
                        "label": "Operation lines",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "operation_lines_ids",
                                                "width": "100%",
                                                "widget": {
                                                    "view": "list.default"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.accounting_entries",
                        "label": "Accounting entries",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "accounting_entries_ids",
                                                "width": "100%",
                                                "widget": {
                                                    "view": "list.default"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.audit",
                        "label": "Audit",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "posted_at",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "cancelled_at",
                                                "width": "50%"
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "reversal_of_id",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "reversal_operations_ids",
                                                "width": "50%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
