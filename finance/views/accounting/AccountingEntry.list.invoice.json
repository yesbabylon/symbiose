{
    "name": "Accounting entries",
    "description": "Invoice accounting entries.",
    "access": {
        "groups": ["finance.default.users"]
    },
    "operations": {
        "total": {
            "credit": {
                "operation": "SUM",
                "usage": "amount/money:2"
            },
            "debit": {
                "operation": "SUM",
                "usage": "amount/money:2"
            }
        }
    },
    "limit": 100,
    "layout": {
        "items": [
            {
                "type": "field",
                "value": "entry_number",
                "width": "35%"
            },
            {
                "type": "field",
                "label": "Journal",
                "value": "journal_id",
                "width": "15%"
            },
            {
                "type": "field",
                "label": "Balanced",
                "value": "is_balanced",
                "width": "10%"
            },
            {
                "type": "field",
                "label": "Status",
                "value": "status",
                "width": "15%"
            },
            {
                "type": "field",
                "value": "debit",
                "width": "15%"
            },
            {
                "type": "field",
                "value": "credit",
                "width": "15%"
            }
        ]
    }
}