{
    "name": "Email",
    "description": "Compose or review an incoming or outgoing email message.",
    "layout": {
        "groups": [
            {
                "sections": [
                    {
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "67%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "date",
                                                "width": "25%",
                                                "readonly": true
                                            },
                                            {
                                                "type": "field",
                                                "value": "subject",
                                                "width": "75%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "from",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "to",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "reply_to",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "cc",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "bcc",
                                                "width": "33%"
                                            }
                                        ]
                                    },
                                    {
                                        "width": "33%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "mailbox_id",
                                                "width": "100%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "direction",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "status",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "message_id",
                                                "width": "100%",
                                                "readonly": true
                                            },
                                            {
                                                "type": "field",
                                                "value": "thread_hash",
                                                "width": "100%",
                                                "visible": false
                                            },
                                            {
                                                "type": "field",
                                                "value": "object_class",
                                                "width": "50%",
                                                "readonly": true
                                            },
                                            {
                                                "type": "field",
                                                "value": "object_id",
                                                "width": "50%",
                                                "readonly": true
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "sections": [
                    {
                        "id": "section.message",
                        "label": "Message",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "body",
                                                "width": "100%",
                                                "widget": {
                                                    "height": "425"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.attachments",
                        "label": "Attachments",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "outgoing_attachment_documents_ids",
                                                "width": "100%",
                                                "visible": ["direction", "=", "outgoing"]
                                            },
                                            {
                                                "type": "field",
                                                "value": "incoming_attachment_documents_ids",
                                                "width": "100%",
                                                "readonly": true,
                                                "visible": ["direction", "=", "incoming"]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.attachment_import",
                        "label": "Attachment import",
                        "visible": ["direction", "=", "incoming"],
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "incoming_attachment_import_status",
                                                "width": "100%",
                                                "readonly": true
                                            },
                                            {
                                                "type": "field",
                                                "value": "incoming_attachment_import_log",
                                                "width": "100%",
                                                "readonly": true,
                                                "widget": {
                                                    "height": "200"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.delivery",
                        "label": "Delivery",
                        "visible": ["direction", "=", "outgoing"],
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "response_status",
                                                "width": "25%",
                                                "readonly": true
                                            },
                                            {
                                                "type": "field",
                                                "value": "has_error",
                                                "width": "25%",
                                                "readonly": true
                                            },
                                            {
                                                "type": "field",
                                                "value": "response",
                                                "width": "100%",
                                                "readonly": true
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
