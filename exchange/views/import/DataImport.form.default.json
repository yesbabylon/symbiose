{
    "name": "Data import",
    "description": "Review a data import.",
    "actions": [
        {
            "id": "action.remove",
            "label": "Remove",
            "description": "Remove this completed or failed data import.",
            "controller": "core_model_do",
            "params": {
                "entity": "exchange\\import\\DataImport",
                "action": "remove",
                "ids": []
            },
            "confirm": true,
            "visible": ["status", "in", ["failing", "imported"]]
        }
    ],
    "layout": {
        "groups": [
            {
                "sections": [
                    {
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "name",
                                                "width": "50%",
                                                "widget": {
                                                    "readonly": true
                                                }
                                            },
                                            {
                                                "type": "field",
                                                "value": "model",
                                                "width": "50%",
                                                "widget": {
                                                    "readonly": true
                                                }
                                            },
                                            {
                                                "type": "field",
                                                "value": "document_id",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "status",
                                                "width": "50%",
                                                "widget": {
                                                    "readonly": true
                                                }
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "logs",
                                                "width": "100%",
                                                "widget": {
                                                    "readonly": true,
                                                    "height": 400
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
