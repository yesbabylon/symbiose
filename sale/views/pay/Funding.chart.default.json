{
    "name": "Sale list",
    "description": "This view displays the list of Fundings",
    "access": {
        "groups": ["sale.default.users"]
    },
    "controller": "core_model_chart",
    "layout": {
        "entity": "sale\\pay\\Funding",
        "group_by": "range",
        "range_interval": "year",
        "range_from": "date.this.year.first",
        "range_to": "date.this.year.last",
        "datasets": [
            {
                "label": "Total paiements",
                "operation": ["COUNT", "object.due_amount"],
                "domain": [["created", ">=", "date.this.month.first"], ["created", "<=", "date.this.month.last"]]
            }
        ]
    }
}