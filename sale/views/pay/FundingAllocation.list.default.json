{
    "name": "Funding allocations",
    "description": "List of accounting movements allocated to fundings.",
    "access": {
        "groups": ["sale.default.users"]
    },
    "operations": {
        "total": {
            "amount": {
                "operation": "SUM",
                "usage": "amount/money:2"
            }
        }
    },
    "layout": {
        "items": [
            {
                "type": "field",
                "value": "organization_id",
                "width": "15%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "receipt_date",
                "width": "15%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "funding_id",
                "width": "25%"
            },
            {
                "type": "field",
                "value": "description",
                "width": "25%"
            },
            {
                "type": "field",
                "value": "amount",
                "width": "10%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "status",
                "width": "10%",
                "sortable": true
            }
        ]
    }
}
