{
    "name": "Service Accounts",
    "description": "This view is intended for displaying the list of service accounts.",
    "access": {
        "groups": ["sale.default.users"]
    },
    "order": "name",
    "sort": "asc",
    "layout": {
        "items": [
            {
                "type": "field",
                "value": "name",
                "width": "25%",
                "sortable": true,
                "readonly": true
            },
            {
                "type": "field",
                "value": "customer_id",
                "label": "Customer",
                "width": "20%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "service_account_type_id",
                "label": "Type",
                "width": "15%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "is_active",
                "label": "Active",
                "width": "10%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "m_reporting",
                "label": "Reporting",
                "width": "12%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "balance_current",
                "label": "Balance",
                "width": "10%",
                "sortable": true,
                "readonly": true
            },
            {
                "type": "field",
                "value": "last_entry_id",
                "label": "Last entry",
                "width": "15%",
                "readonly": true
            },
            {
                "type": "field",
                "value": "renew_auto",
                "label": "Renewal",
                "width": "10%",
                "sortable": true
            }
        ]
    }
}
