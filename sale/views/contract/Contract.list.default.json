{
    "name": "Contracts",
    "description": "This view is intended for displaying the list of contracts.",
    "access": {
        "groups": ["sale.default.users"]
    },
    "order": "id",
    "sort": "asc",
    "operations": {
        "total": {
            "price": {
                "operation": "SUM",
                "usage": "amount/money:2"
            }
        }
    },
    "layout": {
        "items": [
            {
                "type": "field",
                "value": "name",
                "width": "25%",
                "sortable": true,
                "readonly": true
            },
            {
                "type": "field",
                "value": "customer_id",
                "label": "Customer",
                "width": "20%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "contract_type_id",
                "label": "Type",
                "width": "15%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "status",
                "label": "Status",
                "width": "10%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "is_active",
                "label": "Active",
                "width": "10%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "date_from",
                "label": "From",
                "width": "12%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "date_to",
                "label": "To",
                "width": "12%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "price",
                "label": "Price",
                "width": "10%",
                "sortable": true,
                "readonly": true
            }
        ]
    }
}
