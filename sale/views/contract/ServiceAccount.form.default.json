{
    "name": "Service Account",
    "description": "This form displays a service account.",
    "access": {
        "groups": ["sale.default.users"]
    },
    "layout": {
        "groups": [
            {
                "sections": [
                    {
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "name",
                                                "width": "100%",
                                                "readonly": true,
                                                "widget": {
                                                    "heading": true
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "customer_id",
                                                "label": "Customer",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "status",
                                                "label": "Status",
                                                "width": "50%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "sections": [
                    {
                        "id": "section.details",
                        "label": "Details",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "service_account_type_id",
                                                "label": "Service account type",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "is_active",
                                                "label": "Active",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "date_from",
                                                "label": "From",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "date_to",
                                                "label": "To",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "reporting_from",
                                                "label": "Reporting from",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "m_reporting",
                                                "label": "Reporting mode",
                                                "width": "50%"
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "is_invoiceable",
                                                "label": "Invoiceable",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "is_bonus",
                                                "label": "Bonus",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "balance_current",
                                                "label": "Current balance",
                                                "width": "50%",
                                                "readonly": true
                                            },
                                            {
                                                "type": "field",
                                                "value": "has_balance_changed",
                                                "label": "Balance changed",
                                                "width": "50%",
                                                "readonly": true
                                            },
                                            {
                                                "type": "field",
                                                "value": "last_entry_id",
                                                "label": "Last entry",
                                                "width": "50%",
                                                "readonly": true
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "description",
                                                "label": "Description",
                                                "width": "100%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.monthly_target",
                        "label": "Monthly target",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "has_monthly_target",
                                                "label": "Has monthly target",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "monthly_target",
                                                "label": "Monthly target",
                                                "width": "50%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.renewal",
                        "label": "Renewal",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "renew_auto",
                                                "label": "Automatic renewal",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "renew_amount",
                                                "label": "Renewal amount",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "renew_floor",
                                                "label": "Renewal floor",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "has_renew_alert_sent",
                                                "label": "Renew alert sent",
                                                "width": "50%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.reports",
                        "label": "Reports",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "reports_ids",
                                                "width": "100%",
                                                "widget": {
                                                    "header": {
                                                        "actions": {
                                                            "ACTION.CREATE": false
                                                        }
                                                    }
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.entries",
                        "label": "Entries",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "service_account_entries_ids",
                                                "width": "100%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
