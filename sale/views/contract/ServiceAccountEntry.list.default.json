{
    "name": "Service Account Entries",
    "description": "This view is intended for displaying the list of service account entries.",
    "access": {
        "groups": ["sale.default.users"]
    },
    "order": "date",
    "sort": "desc",
    "layout": {
        "items": [
            {
                "type": "field",
                "value": "id",
                "width": "8%",
                "sortable": true,
                "readonly": true
            },
            {
                "type": "field",
                "value": "date",
                "label": "Date",
                "width": "12%",
                "sortable": true,
                "readonly": true
            },
            {
                "type": "field",
                "value": "service_account_id",
                "label": "Service account",
                "width": "20%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "customer_id",
                "label": "Customer",
                "width": "18%",
                "sortable": true,
                "readonly": true
            },
            {
                "type": "field",
                "value": "employee_id",
                "label": "Employee",
                "width": "15%"
            },
            {
                "type": "field",
                "value": "description",
                "label": "Description",
                "width": "25%"
            },
            {
                "type": "field",
                "value": "points",
                "label": "Points",
                "width": "10%",
                "sortable": true,
                "readonly": true
            },
            {
                "type": "field",
                "value": "is_posted",
                "label": "Posted",
                "width": "10%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "report_id",
                "label": "Report",
                "width": "12%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "is_locked",
                "label": "Locked",
                "width": "10%",
                "sortable": true,
                "readonly": true
            }
        ]
    }
}
