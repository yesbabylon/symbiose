{
    "name": "Service Account",
    "description": "This form displays a service account.",
    "access": {
        "groups": ["sale.default.users"]
    },
    "layout": {
        "groups": [
            {
                "sections": [
                    {
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "customer_id",
                                                "label": "Customer",
                                                "width": "50%"
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "sections": [
                    {
                        "id": "section.details",
                        "label": "Details",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "contract_type_id",
                                                "label": "Service account type",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "m_reporting",
                                                "label": "Reporting mode",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "date_from",
                                                "label": "From",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "date_to",
                                                "label": "To",
                                                "width": "50%"
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "is_invoiceable",
                                                "label": "Invoiceable",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "renew_auto",
                                                "label": "Automatic renewal",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "renew_floor",
                                                "label": "Renewal floor",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "renew_amount",
                                                "label": "Renewal amount",
                                                "width": "50%"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "description",
                                                "label": "Description",
                                                "width": "100%",
                                                "widget": {
                                                    "height": "325"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.advanced",
                        "label": "Advanced",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "has_monthly_target",
                                                "label": "Has monthly target",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "monthly_target",
                                                "label": "Monthly target",
                                                "width": "50%"
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "reporting_from",
                                                "label": "Reporting from",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "has_balance_changed",
                                                "label": "Balance changed",
                                                "width": "50%",
                                                "readonly": true
                                            },
                                            {
                                                "type": "field",
                                                "value": "has_renew_alert_sent",
                                                "label": "Renew alert sent",
                                                "width": "50%",
                                                "readonly": true
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
