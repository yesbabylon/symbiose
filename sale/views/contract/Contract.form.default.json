{
    "name": "Contract",
    "description": "Contracts are formal agreement regarding the delivery of products or services concluded between two parties.",
    "access": {
        "groups": ["sale.default.users"]
    },
    "layout": {
        "groups": [
            {
                "sections": [
                    {
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "name",
                                                "width": "100%",
                                                "readonly": true,
                                                "widget": {
                                                    "heading": true
                                                }
                                            },
                                            {
                                                "type": "field",
                                                "value": "customer_id",
                                                "label": "Customer",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "contract_type_id",
                                                "label": "Contract type",
                                                "width": "50%"
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "status",
                                                "label": "Status",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "is_active",
                                                "label": "Active",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "date_from",
                                                "label": "From",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "date_to",
                                                "label": "To",
                                                "width": "50%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "sections": [
                    {
                        "id": "section.details",
                        "label": "Details",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "proposal_valid_until",
                                                "label": "Proposal valid until",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "sent_at",
                                                "label": "Sent at",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "accepted_at",
                                                "label": "Accepted at",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "rejected_at",
                                                "label": "Rejected at",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "rejection_reason",
                                                "label": "Rejection reason",
                                                "width": "100%"
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "total",
                                                "label": "Total",
                                                "width": "50%",
                                                "readonly": true
                                            },
                                            {
                                                "type": "field",
                                                "value": "price",
                                                "label": "Price",
                                                "width": "50%",
                                                "readonly": true
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "description",
                                                "label": "Description",
                                                "width": "100%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.lines",
                        "label": "Contract Lines",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "contract_lines_ids",
                                                "width": "100%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
