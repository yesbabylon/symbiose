{
    "name": "Sale invoice",
    "description": "Invoice creation form.",
    "access": {
        "groups": ["sale.default.users"]
    },
    "extends": {
        "entity": "finance\\accounting\\Invoice",
        "view": "form.default"
    },
    "layout": {
        "remove": [
            "item.invoice_purpose",
            "item.due_date",
            "section.invoice_lines",
            "section.accounting_entries"
        ],
        "update": {
            "item.invoice_number": {
                "after": [
                    {
                        "type": "field",
                        "label": "Customer",
                        "value": "customer_id",
                        "width": "50%"
                    }
                ]
            },
            "item.invoice_type": {
                "after": [
                    {
                        "type": "field",
                        "value": "due_date",
                        "width": "33%",
                        "visible": ["status", "=", "posted"]
                    },
                    {
                        "type": "field",
                        "value": "payment_terms_id",
                        "width": "33%",
                        "visible": ["status", "<>", "posted"]
                    }
                ]
            },
            "item.reversed_invoice_id": {
                "after": [
                    {
                        "type": "field",
                        "value": "customer_ref",
                        "width": "33%"
                    }
                ]
            },
            "item.emission_date": {
                "attributes": {
                    "visible": ["status", "<>", "proforma"]
                }
            }
        }
    }
}
