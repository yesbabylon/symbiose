{
    "name": "Sale invoice",
    "description": "An invoice is a legal document issued by a seller to a buyer that relates to a sale, and is part of the accounting system.",
    "access": {
        "groups": ["sale.default.users"]
    },
    "controller": "sale_accounting_invoice_collect",
    "domain": ["customer_id", ">", 0],
    "header": {
        "actions": {
            "ACTION.CREATE" : [
                {
                    "view_id": "form.create",
                    "description": "Overload form to use for invoice creation."
                }
            ]
        }
    },
    "order": "emission_date",
    "sort": "desc",
    "operations": {
        "total": {
            "total": {
                "operation": "SUM",
                "usage": "amount/money:2"
            },
            "price": {
                "operation": "SUM",
                "usage": "amount/money:2"
            }
        }
    },
    "limit": 100,
    "layout": {
        "items": [
            {
                "id": "item.name",
                "type": "field",
                "value": "name",
                "width": "20%"
            },
            {
                "id": "item.customer",
                "type": "field",
                "label": "Customer",
                "value": "customer_id",
                "width": "20%",
                "sortable": true
            },
            {
                "id": "item.emission.date",
                "type": "field",
                "value": "emission_date",
                "width": "20%",
                "widget": {
                    "sortable": true,
                    "usage": "date/plain.short"
                }
            },
            {
                "type": "field",
                "value": "status",
                "width": "20%"
            },
            {
                "type": "field",
                "value": "total",
                "width": "15%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "price",
                "width": "15%",
                "sortable": true
            }
        ]
    }
}
