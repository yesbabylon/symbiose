{
    "name": "Subscription",
    "description": "This form holds the fields for modifying a commercial subscription.",
    "actions": [
        {
            "id": "action.add-subscription-entry",
            "label": "Create Entry",
            "controller": "sale_subscription_add-subscriptionentry",
            "visible": ["has_current_sale_entry", "=", false]
        }
    ],
    "layout": {
        "groups": [
            {
                "sections": [
                    {
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "name",
                                                "width": "75%",
                                                "widget": {"heading": true}
                                            },
                                            {
                                                "type": "field",
                                                "value": "model",
                                                "visible": false
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                            {"type": "field", "value": "date_from", "width": "33%"},
                                            {"type": "field", "value": "duration", "width": "33%"},
                                            {"type": "field", "value": "date_to", "width": "33%", "readonly": true}
                                        ]
                                    }
                                ]
                            },
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {"type": "field", "value": "is_auto_renew", "width": "33%"}
                                        ]
                                    },
                                    {
                                        "id": "row.expirations",
                                        "width": "50%",
                                        "items": [
                                            {"type": "label", "value": "", "width": "33%"},
                                            {"type": "field", "value": "has_upcoming_expiry", "width": "33%", "readonly": true},
                                            {"type": "field", "value": "is_expired", "width": "33%", "readonly": true}
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "sections": [
                    {
                        "id": "section.details",
                        "label": "Details",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {"type": "field", "value": "ref_order", "label": "Reference", "width": "50%"}
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                            {"type": "field", "value": "customer_id", "label": "Customer", "width": "50%"},
                                            {"type": "field", "value": "infra_subscription_id", "width": "50%", "readonly": true}
                                        ]
                                    }
                                ]
                            },
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {"type": "field", "value": "pricing_mode", "label": "Pricing mode", "width": "33%"},
                                            {"type": "field", "value": "product_id", "label": "Product (Catalog)", "width": "50%"}
                                        ]
                                    }
                                ]
                            },
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {"type": "field", "value": "price_id", "label": "Price", "width": "33%"},
                                            {"type": "field", "value": "qty", "width": "15%", "visible": ["pricing_mode", "=", "consumption"]},
                                            {"type": "field", "value": "price", "width": "15%"}
                                        ]
                                    }
                                ]
                            },
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {"type": "field", "value": "description", "width": "100%"}
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.entries",
                        "label": "Entries",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "subscription_entries_ids",
                                                "width": "100%",
                                                "widget": {
                                                    "view": "list.selection",
                                                    "header": {
                                                        "actions": {
                                                            "ACTION.SELECT": false,
                                                            "ACTION.CREATE": false
                                                        }
                                                    }
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
