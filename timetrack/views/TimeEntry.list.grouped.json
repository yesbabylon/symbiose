{
    "name": "Time entries by day and user",
    "description": "Listing of all time entries grouped by day and performed user.",
    "controller": "timetrack_TimeEntry_collect",
    "order": "date,user_id,time_start",
    "sort": "desc",
    "limit": 500,
    "header": {
        "advanced_search": {
            "open": true,
            "submit": "manual"
        }
    },
    "operations": {
        "total": {
            "duration": {
                "operation": "SUM",
                "usage": "time/plain"
            },
            "billable_duration": {
                "operation": "SUM",
                "usage": "time/plain"
            },
            "billed_duration": {
                "operation": "SUM",
                "usage": "time/plain"
            },
            "total": {
                "operation": "SUM",
                "usage": "amount/money:2"
            }
        }
    },
    "group_by": [
        {
            "open": true,
            "colspan": 4,
            "field": "date",
            "operations": {
                "duration": {
                    "operation": "SUM",
                    "usage": "time/plain"
                },
                "billable_duration": {
                    "operation": "SUM",
                    "usage": "time/plain"
                },
                "billed_duration": {
                    "operation": "SUM",
                    "usage": "time/plain"
                },
                "total": {
                    "operation": "SUM",
                    "usage": "amount/money:2"
                }
            }
        },
        {
            "open": false,
            "colspan": 4,
            "field": "user_id",
            "order": "name",
            "operations": {
                "duration": {
                    "operation": "SUM",
                    "usage": "time/plain"
                },
                "billable_duration": {
                    "operation": "SUM",
                    "usage": "time/plain"
                },
                "billed_duration": {
                    "operation": "SUM",
                    "usage": "time/plain"
                },
                "total": {
                    "operation": "SUM",
                    "usage": "amount/money:2"
                }
            }
        }
    ],
    "layout": {
        "items": [
            {
                "type": "field",
                "label": "Date",
                "value": "date",
                "width": "0%",
                "visible": false,
                "widget": {
                    "usage": "date/plain.short"
                }
            },
            {
                "type": "field",
                "label": "Performed by",
                "value": "user_id",
                "width": "0%",
                "visible": false,
                "readonly": true
            },
            {
                "type": "field",
                "value": "name",
                "width": "25%",
                "sortable": true,
                "readonly": true
            },
            {
                "type": "field",
                "label": "Customer",
                "value": "customer_id",
                "width": "10%",
                "sortable": true,
                "readonly": true,
                "visible": false
            },
            {
                "type": "field",
                "label": "Project",
                "value": "project_id",
                "width": "15%",
                "sortable": true,
                "readonly": true
            },
            {
                "type": "field",
                "label": "Origin",
                "value": "origin",
                "width": "8%",
                "sortable": true,
                "readonly": true
            },
            {
                "type": "field",
                "label": "Start",
                "value": "time_start",
                "width": "8%",
                "sortable": true
            },
            {
                "type": "field",
                "label": "End",
                "value": "time_end",
                "width": "8%",
                "sortable": true
            },
            {
                "type": "field",
                "label": "Duration",
                "value": "duration",
                "width": "10%",
                "sortable": true
            },
            {
                "type": "field",
                "label": "Billable",
                "value": "billable_duration",
                "width": "10%",
                "sortable": true
            },
            {
                "type": "field",
                "label": "Billed",
                "value": "billed_duration",
                "width": "10%",
                "sortable": true
            },
            {
                "type": "field",
                "label": "Total",
                "value": "total",
                "width": "10%",
                "sortable": true,
                "widget": {
                    "usage": "amount/money:2"
                }
            },
            {
                "type": "field",
                "label": "Status",
                "value": "status",
                "width": "8%",
                "sortable": true,
                "readonly": true
            }
        ]
    }
}
