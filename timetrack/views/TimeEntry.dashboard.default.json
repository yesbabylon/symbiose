{
    "name": "Timetrack dashboard",
    "description": "Default dashboard for monitoring current time entries, validation and billing queues.",
    "icon": "dashboard",
    "layout": {
        "groups": [
            {
                "id": "group.main",
                "height": "100%",
                "sections": [
                    {
                        "rows": [
                            {
                                "height": "100%",
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "id": "item.to_validate",
                                                "label": "To validate",
                                                "description": "Time entries waiting to be validated.",
                                                "height": "50%",
                                                "width": "100%",
                                                "entity": "timetrack\\TimeEntry",
                                                "view": "list.default",
                                                "domain": [
                                                    ["status", "=", "ready"]
                                                ]
                                            },
                                            {
                                                "id": "item.to_bill",
                                                "label": "To bill",
                                                "description": "Validated time entries waiting to be invoiced.",
                                                "height": "50%",
                                                "width": "100%",
                                                "entity": "timetrack\\TimeEntry",
                                                "view": "list.billable"
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "id": "item.month_overview",
                                                "label": "Month overview",
                                                "description": "All non-billed time entries for the current month.",
                                                "height": "100%",
                                                "width": "100%",
                                                "entity": "timetrack\\TimeEntry",
                                                "view": "list.default",
                                                "domain": [
                                                    ["status", "<>", "billed"],
                                                    ["date", ">=", "date.this.month.first()"],
                                                    ["date", "<=", "date.this.month.last()"]
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
