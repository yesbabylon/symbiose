{
    "name": "Time entries",
    "controller": "core_model_chart",
    "layout": {
        "entity": "timetrack\\TimeEntry",
        "stacked": false,
        "group_by": "field",
        "field": "user_id",
        "range_field": "created",
        "range_from": "date.this.year.first",
        "range_to": "date.this.year.last",
        "datasets": [
            {
                "label": "Billed duration",
                "operation": ["SUM", "object.billed_duration"]
            }
        ]
    }
}
