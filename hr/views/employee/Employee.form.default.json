{
    "name": "Employee",
    "description": "Form holding basic information about an employee (Partner).",
    "access": {
        "groups": ["hr.default.users"]
    },
    "extends": {
        "entity": "identity\\Partner",
        "view": "form.default"
    },
    "actions": [
        {
            "id": "action.create_account",
            "label": "Create a User account",
            "icon": "play_arrow",
            "description": "Create a user account relating to the Employee.",
            "controller": "hr_employee_Employee_create-user",
            "confirm": false,
            "visible": ["operators", "in", "user.groups"]
        }
    ],
    "layout": {
        "remove": [
            "section.advanced",
            "group.partner_info",
            "field.type_id",
            "field.has_vat"
        ],
        "update": {
            "field.lang_id": {
                "after": [
                    {
                        "type": "field",
                        "label": "Identity of Employee",
                        "value": "partner_identity_id",
                        "width": "100%"
                    }
                ]
            },
            "section.identity_info": {
                "after": [
                    {
                        "id": "section.employee",
                        "label": "Employee specifics",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "employee_number",
                                                "width": "100%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "description",
                                                "width": "100%"
                                            },
                                            {
                                                "type": "field",
                                                "label": "Role",
                                                "value": "role_id",
                                                "width": "75%",
                                                "readonly": true
                                            },
                                            {
                                                "type": "field",
                                                "value": "is_active",
                                                "width": "25%"
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "first_employment_date",
                                                "width": "100%",
                                                "readonly":  true
                                            }
                                        ]
                                    },
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "contracts_ids",
                                                "width": "100%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.roles",
                        "label": "Roles",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "role_assignments_ids",
                                                "width": "100%",
                                                "widget": {
                                                    "view": "list.employee"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.absences",
                        "label": "Absences",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "absences_ids",
                                                "width": "100%",
                                                "widget": {
                                                    "header": {
                                                        "view": "list.default",
                                                        "actions": {
                                                            "ACTION.SELECT": false,
                                                            "ACTION.CREATE": false
                                                        }
                                                    }
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        }
    }
}
