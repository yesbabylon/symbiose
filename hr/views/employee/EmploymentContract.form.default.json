{
    "name": "Employment contract",
    "description": "Form for an employment contract.",
    "access": {
        "groups": ["hr.default.users"]
    },
    "layout": {
        "groups": [
            {
                "sections": [
                    {
                        "id": "section.general",
                        "label": "General",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "employee_id",
                                                "width": "100%",
                                                "widget": {
                                                    "heading": true
                                                }
                                            },
                                            {
                                                "type": "field",
                                                "value": "job_title",
                                                "width": "100%"
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "status",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "contract_type",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "date_start",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "date_end",
                                                "width": "50%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.working_conditions",
                        "label": "Working conditions",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "work_regime",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "weekly_hours",
                                                "width": "50%"
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "salary_period",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "contractual_salary",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "current_salary",
                                                "width": "34%",
                                                "readonly": true
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.salary_history",
                        "label": "Salary history",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "employment_salaries_ids",
                                                "width": "100%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
