{
    "name": "Contacts",
    "description": "Searchable list of all people and organizations.",
    "controller": "identity_Identity_collect",
    "order": "name",
    "sort": "asc",
    "limit": 50,
    "header": {
        "advanced_search": {
            "open": true,
            "submit": "manual"
        }
    },
    "layout": {
        "items": [
            {
                "type": "field",
                "value": "name",
                "width": "25%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "type",
                "width": "10%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "email",
                "width": "20%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "phone",
                "width": "15%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "mobile",
                "width": "15%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "vat_number",
                "width": "15%",
                "sortable": true
            }
        ]
    }
}
