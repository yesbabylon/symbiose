{
    "name": "Contacts dashboard summary",
    "description": "Contact counts and data quality alerts.",
    "controller": "identity_contacts_collect-summary",
    "limit": 1,
    "header": {
        "selection": {
            "default": false
        },
        "actions": {
            "ACTION.CREATE": false
        }
    },
    "layout": {
        "items": [
            {
                "id": "item.internal",
                "type": "field",
                "label": "Internal",
                "value": "internal_count",
                "width": "16%",
                "readonly": true
            },
            {
                "id": "item.customers",
                "type": "field",
                "label": "Customers",
                "value": "customer_count",
                "width": "16%",
                "readonly": true
            },
            {
                "id": "item.suppliers",
                "type": "field",
                "label": "Suppliers",
                "value": "supplier_count",
                "width": "16%",
                "readonly": true
            },
            {
                "id": "item.total",
                "type": "field",
                "label": "Total",
                "value": "total_count",
                "width": "16%",
                "readonly": true
            },
            {
                "id": "item.incomplete",
                "type": "field",
                "label": "Incomplete",
                "value": "incomplete_count",
                "width": "18%",
                "readonly": true
            },
            {
                "id": "item.duplicates",
                "type": "field",
                "label": "Duplicates",
                "value": "duplicate_count",
                "width": "18%",
                "readonly": true
            }
        ]
    }
}
