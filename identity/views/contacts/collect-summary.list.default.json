{
    "name": "Contacts dashboard summary",
    "description": "Contact counts by type and data quality alert category.",
    "controller": "identity_contacts_collect-summary",
    "limit": 5,
    "operations": {
        "total": {
            "total": {
                "operation": "SUM",
                "usage": "numeric/integer"
            }
        }
    },
    "header": {
        "selection": {
            "default": false
        },
        "actions": {
            "ACTION.CREATE": false
        }
    },
    "layout": {
        "items": [
            {
                "id": "item.type",
                "type": "field",
                "label": "Contact type",
                "value": "type",
                "width": "50%",
                "readonly": true
            },
            {
                "id": "item.total",
                "type": "field",
                "label": "Number of contacts",
                "value": "total",
                "width": "50%",
                "readonly": true
            }
        ]
    }
}
