{
    "name": "Contacts dashboard",
    "description": "Search all contacts and monitor contact quality indicators.",
    "icon": "contacts",
    "refresh_interval": 300,
    "layout": {
        "groups": [
            {
                "id": "group.main",
                "height": "100%",
                "sections": [
                    {
                        "rows": [
                            {
                                "height": "100%",
                                "columns": [
                                    {
                                        "width": "66%",
                                        "items": [
                                            {
                                                "id": "item.contacts",
                                                "label": "All contacts",
                                                "description": "Search a person, company, email address, phone number or VAT number.",
                                                "height": "100%",
                                                "width": "100%",
                                                "entity": "identity\\Identity",
                                                "view": "list.contacts"
                                            }
                                        ]
                                    },
                                    {
                                        "width": "33%",
                                        "items": [
                                            {
                                                "id": "item.summary",
                                                "label": "Contacts summary",
                                                "description": "Counts of contacts by type.",
                                                "height": "50%",
                                                "width": "100%",
                                                "entity": "identity\\contacts\\collect-summary",
                                                "view": "list.default"
                                            },
                                            {
                                                "id": "item.alerts",
                                                "label": "Alerts",
                                                "description": "Counts of contacts by role and data quality alerts.",
                                                "height": "50%",
                                                "width": "100%",
                                                "entity": "core\\alert\\Message",
                                                "view": "list.default",
                                                "domain":  [ ["object_class", "in", ["identity\\Contact", "sale\\customer\\CustomerContact", "purchase\\supplier\\SupplierContact"]] ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
