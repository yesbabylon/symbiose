{
    "name": "Contacts menu",
    "layout": {
        "items": [
            {
                "id": "item.organization",
                "label": "My organization",
                "description": "Manage the main organization, its related entities and internal contacts.",
                "icon": "corporate_fare",
                "type": "parent",
                "children": [
                    {
                        "id": "item.organization.main",
                        "type": "entry",
                        "label": "Main entity",
                        "icon": "business",
                        "description": "Main legal entity of the installation.",
                        "context": {
                            "entity": "identity\\Organization",
                            "view": "list.default",
                            "domain": ["id", "=", 1]
                        }
                    },
                    {
                        "id": "item.organization.related",
                        "type": "entry",
                        "label": "Related companies and entities",
                        "icon": "account_tree",
                        "description": "Legal entities related to the main organization.",
                        "context": {
                            "entity": "identity\\Organization",
                            "view": "list.default",
                            "domain": ["id", "<>", 1]
                        }
                    },
                    {
                        "id": "item.organization.establishments",
                        "type": "entry",
                        "label": "Establishments",
                        "icon": "apartment",
                        "description": "Establishment units of the organization.",
                        "context": {
                            "entity": "identity\\Establishment",
                            "view": "list.default"
                        }
                    },
                    {
                        "id": "item.organization.internal_contacts",
                        "label": "Internal contacts",
                        "description": "Employees and contact groups of the organization.",
                        "icon": "people",
                        "type": "parent",
                        "children": [
                            {
                                "id": "item.organization.internal_contacts.contacts",
                                "type": "entry",
                                "label": "Contacts",
                                "icon": "badge",
                                "description": "All contacts.",
                                "context": {
                                    "entity": "identity\\Contact",
                                    "view": "list.default"
                                }
                            },
                            {
                                "id": "item.organization.internal_contacts.employees",
                                "type": "entry",
                                "label": "Employees",
                                "icon": "badge",
                                "description": "People with an employee role.",
                                "context": {
                                    "entity": "hr\\employee\\Employee",
                                    "view": "list.default"
                                }
                            },
                            {
                                "id": "item.organization.internal_contacts.groups",
                                "type": "entry",
                                "label": "Contact groups",
                                "icon": "group",
                                "description": "Groups used to organize contacts.",
                                "context": {
                                    "entity": "identity\\ContactGroup",
                                    "view": "list.default"
                                }
                            }
                        ]
                    }
                ]
            },
            {
                "id": "item.customers",
                "type": "entry",
                "label": "Customers",
                "icon": "handshake",
                "description": "Contacts with a customer role.",
                "context": {
                    "entity": "identity\\Identity",
                    "view": "list.contacts",
                    "domain": ["customer_id", "<>", null]
                }
            },
            {
                "id": "item.suppliers",
                "type": "entry",
                "label": "Suppliers",
                "icon": "local_shipping",
                "description": "Contacts with a supplier role.",
                "context": {
                    "entity": "identity\\Identity",
                    "view": "list.contacts",
                    "domain": ["supplier_id", "<>", null]
                }
            }
        ]
    }
}
