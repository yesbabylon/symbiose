{
    "name": "Cloud Project",
    "description": "Default form for cloud projects.",
    "actions": [
        {
            "id": "action.sync-ovh-provider-catalog",
            "label": "Synchronize provider catalog",
            "controller": "infra_cloud_ovh_sync-provider-catalog",
            "visible": ["cloud_provider_code", "=", "ovh"]
        },
        {
            "id": "action.create-b2-server",
            "label": "Create OVHcloud b2 server",
            "controller": "infra_cloud_ovh_create-b2-server",
            "visible": ["cloud_provider_code", "=", "ovh"]
        },
        {
            "id": "action.create-k2-server",
            "label": "Create OVHcloud k2 server (backups)",
            "controller": "infra_cloud_ovh_create-k2-server",
            "visible": ["cloud_provider_code", "=", "ovh"]
        }
    ],
    "layout": {
        "groups": [
            {
                "sections": [
                    {
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "name",
                                                "width": "100%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "description",
                                                "width": "100%"
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "extref_project_id",
                                                "width": "100%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "cloud_provider_id",
                                                "width": "100%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "cloud_provider_code",
                                                "visible": false
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "sections": [
                    {
                        "id": "section.servers",
                        "label": "Servers",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "servers_ids",
                                                "width": "100%",
                                                "widget": {
                                                    "view_id": "list.project"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.available-regions",
                        "label": "Available regions",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "available_regions",
                                                "width": "100%",
                                                "widget": {
                                                    "height": 120
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.provider-info",
                        "label": "Provider info",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "api_credentials",
                                                "width": "100%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "provider_catalog",
                                                "width": "100%",
                                                "readonly": true,
                                                "widget": {
                                                    "height": 500
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
