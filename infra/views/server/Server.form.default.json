{
    "name": "Server",
    "description": "Default form for Server",
    "actions": [
        {
            "id": "action.sync-status",
            "label": "Synchronize status",
            "controller": "infra_server_Server_sync-status",
            "params": {
                "sync_instances": true
            },
            "visible": ["server_type", "=", "b2"]
        },
        {
            "id": "action.add-check",
            "label": "Add check from example",
            "controller": "infra_server_add-server-check",
            "visible": ["server_type", "in", ["b2", "k2", "s2", "admin"]]
        },
        {
            "id": "action.add-alert-trigger",
            "label": "Add alert trigger from example",
            "controller": "infra_server_add-server-alert-trigger",
            "visible": ["server_type", "in", ["b2", "k2", "s2", "admin"]]
        }
    ],
    "layout": {
        "groups": [
            {
                "sections": [
                    {
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "name",
                                                "width": "66%",
                                                "widget": {
                                                    "heading": true
                                                }
                                            },
                                            {
                                                "type": "field",
                                                "label": "Type",
                                                "value": "server_type",
                                                "width": "33%"
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "label",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "up",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "synced",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "label",
                                                "width": "75%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "sections": [
                    {
                        "id": "section.location",
                        "label": "Cloud location",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "cloud_provider_id",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "region_id",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "zone_id",
                                                "width": "33%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.description",
                        "label": "Description",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "label": "Description",
                                                "value": "description",
                                                "width": "100%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.accesses",
                        "label": "Accesses",
                        "visible": ["state", "<>", "draft"],
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "align": "left",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "accesses_ids",
                                                "width": "100%",
                                                "label": "Accesses",
                                                "widget": {
                                                    "view": "list.server"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.ip-addresses",
                        "label": "IP Addresses",
                        "visible": ["state", "<>", "draft"],
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "ip_address_ids",
                                                "width": "100%",
                                                "label": "IP Address",
                                                "widget": {
                                                    "view": "list.selection"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.products",
                        "label": "Products",
                        "visible": ["state", "<>", "draft"],
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "products_ids",
                                                "width": "100%",
                                                "label": "Products",
                                                "widget":{
                                                    "view": "list.selection"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.instances",
                        "label": "Instances",
                        "visible": ["state", "<>", "draft"],
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "instances_ids",
                                                "width": "100%",
                                                "label": "Instances",
                                                "widget": {
                                                    "view": "list.selection"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.softwares",
                        "label": "Softwares",
                        "visible": ["state", "<>", "draft"],
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "softwares_ids",
                                                "width": "100%",
                                                "label": "Softwares",
                                                "widget": {
                                                    "view": "list.selection"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.statuses",
                        "label": "Statuses",
                        "visible": ["server_type", "in", ["b2", "k2", "s2", "admin"]],
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "id": "label.checks",
                                                "type": "label",
                                                "value": "Checks",
                                                "width": "100%"
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "id": "label.statuses",
                                                "type": "label",
                                                "value": "Statuses",
                                                "width": "100%"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "checks_ids",
                                                "width": "100%",
                                                "label": "Checks"
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "statuses_ids",
                                                "width": "100%",
                                                "label": "Statuses",
                                                "widget": {
                                                    "limit": 10,
                                                    "header": {
                                                        "actions": {
                                                            "ACTION.SELECT": false,
                                                            "ACTION.CREATE": false
                                                        }
                                                    }
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.alert-triggers",
                        "label": "Alert triggers",
                        "visible": ["server_type", "in", ["b2", "k2", "s2", "admin"]],
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "alert_triggers_ids",
                                                "width": "100%",
                                                "label": "Alert triggers"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
