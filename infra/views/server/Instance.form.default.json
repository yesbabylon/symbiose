{
    "name": "Instance",
    "description": "Default form for Instance",
    "actions": [
        {
            "id": "action.sync-status",
            "label": "Synchronize status",
            "controller": "infra_server_Instance_sync-status",
            "params": {
                "scope": "all"
            },
            "visible": ["server_type", "=", "b2"]
        },
        {
            "id": "action.add-check",
            "label": "Add check from example",
            "controller": "infra_server_add-instance-check",
            "visible": ["server_type", "in", ["b2", "k2", "s2", "admin"]]
        },
        {
            "id": "action.add-alert-trigger",
            "label": "Add alert trigger from example",
            "controller": "infra_server_add-instance-alert-trigger",
            "visible": ["server_type", "in", ["b2", "k2", "s2", "admin"]]
        },
        {
            "id": "action.create-dns-record",
            "label": "Create DNS record",
            "description": "Create or update the OVH A record for the instance.",
            "controller": "infra_server_Instance_create-dns-record",
            "confirm": true,
            "params": {
                "id": "object.id"
            },
            "visible": [
                ["server_type", "=", "b2"],
                ["has_dns_record", "=", false]
            ]
        }
    ],
    "layout": {
        "groups": [
            {
                "sections": [
                    {
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "server_type",
                                                "visible": false
                                            },
                                            {
                                                "type": "field",
                                                "value": "has_dns_record",
                                                "visible": false
                                            },
                                            {
                                                "type": "field",
                                                "value": "name",
                                                "width": "66%",
                                                "widget": {
                                                    "heading": true
                                                }
                                            },
                                            {
                                                "type": "field",
                                                "label": "Type",
                                                "value": "instance_type",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "label",
                                                "value": "",
                                                "width": "66%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "b2_instance_type",
                                                "width": "33%"
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "label",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "up",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "synced",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "label",
                                                "width": "75%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "sections": [
                    {
                        "id": "section.details",
                        "label": "Details",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "version",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "branch",
                                                "width": "66%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "url",
                                                "width": "100%"
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "label",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "product_id",
                                                "label": "Product",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "label",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "server_id",
                                                "label": "Server",
                                                "width": "50%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.description",
                        "label": "Description",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "label": "Description",
                                                "value": "description",
                                                "width": "100%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "label": "Accesses",
                        "id": "section.accesses",
                        "visible": ["state", "<>", "draft"],
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "accesses_ids",
                                                "width": "100%",
                                                "widget": {
                                                    "view": "list.selection"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "label": "Softwares",
                        "id": "section.softwares",
                        "visible": ["state", "<>", "draft"],
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "softwares_ids",
                                                "width": "100%",
                                                "label": "Softwares",
                                                "widget": {
                                                    "view": "list.selection"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.statuses",
                        "label": "Statuses",
                        "visible": ["server_type", "in", ["b2", "k2", "s2", "admin"]],
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "id": "label.checks",
                                                "type": "label",
                                                "value": "Checks",
                                                "width": "100%"
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "id": "label.statuses",
                                                "type": "label",
                                                "value": "Statuses",
                                                "width": "100%"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "checks_ids",
                                                "width": "100%",
                                                "label": "Checks"
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "statuses_ids",
                                                "width": "100%",
                                                "label": "Statuses",
                                                "widget": {
                                                    "limit": 10,
                                                    "header": {
                                                        "actions": {
                                                            "ACTION.SELECT": false,
                                                            "ACTION.CREATE": false
                                                        }
                                                    }
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.alert-triggers",
                        "label": "Alert triggers",
                        "visible": ["server_type", "in", ["b2", "k2", "s2", "admin"]],
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "alert_triggers_ids",
                                                "width": "100%",
                                                "label": "Alert triggers"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
