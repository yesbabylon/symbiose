{
    "name": "Service subscriptions",
    "description": "Selected listing of all service subscriptions.",
    "controller": "infra_service_subscription-collect",
    "order": "date_from,date_to,name",
    "sort": "asc",
    "header": {
        "selection": {
            "default": false,
            "actions": [
                {
                    "id": "action.bulk_expiration",
                    "label": "Update expiration columns",
                    "icon": "update",
                    "controller": "infra_service_bulk-expirations",
                    "confirm": true
                }
            ]
        },
        "actions": {
            "ACTION.CREATE": [
                {
                    "view_id": "form.create",
                    "description": "Use the dedicated service subscription creation form."
                }
            ]
        }
    },
    "layout": {
        "items": [
            {"type": "field", "value": "name", "width": "25%", "sortable": true},
            {"type": "field", "value": "service_id", "width": "25%", "sortable": true},
            {"type": "field", "value": "date_from", "width": "12%", "sortable": true, "readonly": true},
            {"type": "field", "value": "date_to", "width": "12%", "sortable": true, "readonly": true},
            {"type": "field", "value": "is_auto_renew", "width": "10%", "sortable": true},
            {"type": "field", "value": "is_expired", "width": "10%", "sortable": true, "readonly": true},
            {"type": "field", "value": "has_external_provider", "width": "12%", "sortable": true, "readonly": true},
            {"type": "field", "value": "service_provider_id", "width": "20%", "sortable": true, "readonly": true},
            {"type": "field", "value": "customer_id", "width": "20%", "sortable": true, "readonly": true},
            {"type": "field", "value": "sale_subscription_id", "width": "20%", "sortable": true, "readonly": true}
        ]
    }
}
